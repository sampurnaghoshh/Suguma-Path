/* ==========================================================================
   SugamaPath — Reading Tool Styles (reading.html)
   Full-viewport two-column tool layout.
   ========================================================================== */

/* ==========================================================================
   Page-level layout: strip default section padding, go edge-to-edge
   ========================================================================== */
.reading-page {
  padding: 0;
}

/* Two-column flex container */
.reading-layout {
  display: flex;
  flex-direction: row;
  min-height: calc(100vh - 64px); /* 64px = nav height */
  align-items: stretch;
}

/* ==========================================================================
   Controls Panel — left column, sticky on desktop
   ========================================================================== */
.controls-panel {
  /* Fixed width on desktop */
  flex: 0 0 380px;
  width: 380px;

  /* Stick to top, scroll internally — stays visible while right column scrolls */
  position: sticky;
  top: 64px;
  height: calc(100vh - 64px);
  overflow-y: auto;

  background-color: var(--color-surface);
  border-right: 1px solid var(--color-border);

  display: flex;
  flex-direction: column;

  /* Thin custom scrollbar so it's not distracting */
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}

.controls-panel::-webkit-scrollbar       { width: 4px; }
.controls-panel::-webkit-scrollbar-track { background: transparent; }
.controls-panel::-webkit-scrollbar-thumb { background-color: var(--color-border); border-radius: 2px; }

/* Panel header — non-scrolling title strip */
.controls-header {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--color-border);
  background-color: var(--color-surface);
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  flex-shrink: 0; /* prevent from being squished */
}

/* ==========================================================================
   Input Section (tabs: Paste / URL)
   ========================================================================== */
.input-section {
  padding: var(--sp-5);
  flex-shrink: 0;
}

/* Segmented tab control */
.tab-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: 3px;
  gap: 3px;
  margin-bottom: var(--sp-4);
}

.tab-btn {
  padding: var(--sp-2) var(--sp-3);
  border: none;
  background: transparent;
  border-radius: calc(var(--border-radius-md) - 3px);
  cursor: pointer;
  font-family: var(--font-active);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  transition:
    background-color var(--transition-fast),
    color var(--transition-fast),
    box-shadow var(--transition-fast);
  text-align: center;
  white-space: nowrap;
}

.tab-btn[aria-selected="true"] {
  background-color: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
  font-weight: 600;
}

.tab-btn:hover:not([aria-selected="true"]) {
  color: var(--color-text);
  background-color: rgba(255,255,255,0.5);
}

/* Tab panels */
.tab-panel {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  animation: fadeIn var(--transition-fast) ease;
}

.tab-panel[hidden] {
  display: none;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Textarea for paste mode */
.reading-textarea {
  width: 100%;
  min-height: 160px;
  max-height: 260px;
  resize: vertical;
  padding: var(--sp-3) var(--sp-4);
  font-family: var(--font-active);
  font-size: var(--text-sm);
  line-height: 1.6;
  color: var(--color-text);
  background-color: var(--color-bg);
  border: 2px solid var(--color-border);
  border-radius: var(--border-radius-md);
  transition:
    border-color var(--transition-fast),
    box-shadow var(--transition-fast);
}

.reading-textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-light);
}

.reading-textarea::placeholder {
  color: var(--color-text-muted);
  opacity: 0.65;
}

/* Meta line below textarea (char count + hint) */
.input-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  padding: 0 var(--sp-1);
}

.input-meta kbd {
  display: inline-block;
  padding: 1px 5px;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  font-family: monospace;
  font-size: 0.9em;
  background-color: var(--color-bg-alt);
  color: var(--color-text-muted);
}

/* URL input section */
.url-field-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.url-note {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: 1.65;
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-sm);
  padding: var(--sp-3);
}

.url-note strong {
  color: var(--color-text);
}

/* Sample URL quick-fill buttons */
.url-samples {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.url-sample-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-full);
  padding: var(--sp-1) var(--sp-3);
  color: var(--color-primary);
  font-size: var(--text-xs);
  font-family: var(--font-active);
  font-weight: 500;
  cursor: pointer;
  transition:
    background-color var(--transition-fast),
    border-color var(--transition-fast);
}

.url-sample-btn:hover {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
}

/* Full-width action buttons inside controls */
.btn--full {
  width: 100%;
  justify-content: center;
}

/* ==========================================================================
   Accessibility Controls Section
   ========================================================================== */
.controls-divider {
  height: 1px;
  background-color: var(--color-border);
  flex-shrink: 0;
}

.controls-section {
  padding: var(--sp-5);
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
  /* Extra bottom padding so last item isn't cut off when scrolling */
  padding-bottom: var(--sp-8);
}

.controls-section__heading {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

/* --- Font segmented toggle --- */
.font-control label.label {
  margin-bottom: var(--sp-2);
}

.font-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: 3px;
  gap: 3px;
}

.font-toggle__btn {
  padding: var(--sp-2) var(--sp-3);
  border: none;
  background: transparent;
  border-radius: calc(var(--border-radius-md) - 3px);
  cursor: pointer;
  font-family: var(--font-active);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  transition:
    background-color var(--transition-fast),
    color var(--transition-fast),
    box-shadow var(--transition-fast);
  text-align: center;
}

.font-toggle__btn.is-active {
  background-color: var(--color-surface);
  color: var(--color-primary);
  box-shadow: var(--shadow-sm);
  font-weight: 700;
}

/* Show each button in its own font as a preview */
.font-toggle__btn[data-font="lexend"]   { font-family: 'Lexend', sans-serif; }
.font-toggle__btn[data-font="dyslexic"] { font-family: 'OpenDyslexic', 'Lexend', sans-serif; }

/* --- Slider groups --- */
.slider-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-3);
}

.slider-label {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text);
  user-select: none;
}

.slider-value {
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--color-primary);
  background-color: var(--color-primary-light);
  padding: 2px var(--sp-2);
  border-radius: var(--border-radius-full);
  min-width: 5ch;
  text-align: center;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ==========================================================================
   Reading Area — right column
   ========================================================================== */
.reading-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
  min-width: 0; /* prevent flex overflow */
}

/* --------------------------------------------------------------------------
   Empty State
   -------------------------------------------------------------------------- */
.reading-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--sp-16) var(--sp-8);
  gap: var(--sp-5);
}

.reading-empty__icon {
  font-size: 4.5rem;
  line-height: 1;
  filter: grayscale(20%);
  /* Gentle float animation */
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-10px); }
}

/* Respect reduce-motion preference */
@media (prefers-reduced-motion: reduce) {
  .reading-empty__icon { animation: none; }
}

.reading-empty__title {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-text);
}

.reading-empty__subtitle {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  max-width: 38ch;
}

.reading-empty__tips {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.reading-empty__tip {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: var(--sp-3) var(--sp-5);
  max-width: 46ch;
  line-height: 1.6;
}

.reading-empty__tip code {
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
  background-color: var(--color-bg-alt);
  padding: 1px 5px;
  border-radius: 3px;
  color: var(--color-primary);
}

/* --------------------------------------------------------------------------
   Loading State
   -------------------------------------------------------------------------- */
.reading-loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-5);
  padding: var(--sp-16);
  text-align: center;
}

.loading-spinner {
  width: 44px;
  height: 44px;
  border: 3.5px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.reading-loading p {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  max-width: 100%;
}

/* --------------------------------------------------------------------------
   Error State
   -------------------------------------------------------------------------- */
.reading-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-4);
  padding: var(--sp-16) var(--sp-8);
  text-align: center;
}

.reading-error__icon  { font-size: 3.5rem; }

.reading-error__title {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-error);
}

.reading-error__message {
  color: var(--color-text-muted);
  max-width: 44ch;
  line-height: 1.65;
}

.reading-error__hint {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  max-width: 44ch;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: var(--sp-3) var(--sp-5);
  line-height: 1.65;
}

/* --------------------------------------------------------------------------
   Content State (article or plain text)
   -------------------------------------------------------------------------- */
.reading-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Top info bar: word count + actions */
.reading-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-6);
  background-color: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  flex-shrink: 0;
  position: sticky;
  top: 64px;
  z-index: 10;
}

.reading-bar__stats {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  flex-wrap: wrap;
}

.reading-bar__sep {
  color: var(--color-border);
  font-size: 1.2em;
  user-select: none;
}

.reading-bar__source {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-secondary);
  background-color: var(--color-secondary-light);
  padding: var(--sp-1) var(--sp-3);
  border-radius: var(--border-radius-full);
  text-decoration: none;
  max-width: 28ch;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reading-bar__source:hover {
  color: var(--color-secondary);
  opacity: 0.85;
}

.reading-bar__actions {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex-shrink: 0;
}

/* The actual reading output — styles here are the baseline; JS overrides
   via CSS custom properties on this element for live slider updates */
.reading-output {
  flex: 1;
  padding: var(--sp-12) var(--sp-8);

  /* Typography vars — set by JS from sliders */
  font-size:      var(--r-font-size,      1.125rem);
  line-height:    var(--r-line-height,    1.85);
  letter-spacing: var(--r-letter-spacing, 0.04em);
  word-spacing:   var(--r-word-spacing,   0.12em);
  font-family:    var(--font-active);
  color:          var(--color-text);

  /* Comfortable reading column, centred in the right pane */
  max-width: 72ch;
  margin-inline: auto;
  width: 100%;
}

/* --- Typography inside the article --- */
.reading-output h1 {
  font-size: clamp(1.4rem, 3vw, 2rem);
  line-height: 1.2;
  margin-bottom: var(--sp-3);
  letter-spacing: -0.01em;
}

.reading-output .article-byline {
  font-size: 0.85em;
  color: var(--color-text-muted);
  margin-bottom: var(--sp-8);
  padding-bottom: var(--sp-5);
  border-bottom: 1px solid var(--color-border);
}

.reading-output h2 {
  font-size: 1.3em;
  margin-top: 2em;
  margin-bottom: 0.5em;
  padding-top: var(--sp-4);
}

.reading-output h3 {
  font-size: 1.15em;
  margin-top: 1.5em;
  margin-bottom: 0.4em;
}

.reading-output p {
  margin-bottom: 1.25em;
  max-width: 100%;
}

.reading-output a {
  color: var(--color-primary);
  text-decoration-thickness: 1px;
}

.reading-output ul,
.reading-output ol {
  padding-left: 1.6em;
  margin-bottom: 1.25em;
}

.reading-output li {
  margin-bottom: 0.4em;
}

.reading-output blockquote {
  border-left: 4px solid var(--color-primary);
  margin-inline: 0;
  padding-left: var(--sp-5);
  color: var(--color-text-muted);
  font-style: italic;
}

.reading-output img {
  border-radius: var(--border-radius-md);
  margin-block: var(--sp-6);
  max-width: 100%;
  height: auto;
}

.reading-output table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1.25em;
  font-size: 0.9em;
}

.reading-output th,
.reading-output td {
  text-align: left;
  padding: var(--sp-2) var(--sp-3);
  border: 1px solid var(--color-border);
}

.reading-output th {
  background-color: var(--color-bg-alt);
  font-weight: 600;
}

.reading-output figure {
  margin-inline: 0;
  margin-block: var(--sp-6);
}

.reading-output figcaption {
  font-size: 0.8em;
  color: var(--color-text-muted);
  margin-top: var(--sp-2);
  font-style: italic;
}

/* Plain text paragraphs get a bit more spacing */
.reading-output.plain-text p {
  margin-bottom: 1.5em;
}

/* ==========================================================================
   Responsive — mobile stacked layout
   ========================================================================== */
@media (max-width: 860px) {
  .reading-layout {
    flex-direction: column;
  }

  .controls-panel {
    position: static;
    width: 100%;
    flex: none;
    height: auto;
    border-right: none;
    border-bottom: 1px solid var(--color-border);
    /* Don't let it scroll internally on mobile — just flows naturally */
    overflow-y: visible;
  }

  .reading-area {
    min-height: 50vh;
  }

  .reading-output {
    padding: var(--sp-8) var(--sp-5);
  }

  .reading-bar {
    position: static; /* don't sticky on mobile, too much lost space */
  }
}

@media (max-width: 480px) {
  .reading-empty {
    padding: var(--sp-10) var(--sp-5);
  }

  .reading-empty__title { font-size: var(--text-xl); }
  .reading-empty__subtitle { font-size: var(--text-md); }
}
