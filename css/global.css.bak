/* ==========================================================================
   SugamaPath — Global Styles
   Custom properties, resets, typography, shared components, theming.
   All pages import this file first.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Google Fonts — Lexend (default readable) + OpenDyslexic via @font-face
   -------------------------------------------------------------------------- */
@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap');

/* OpenDyslexic is not on Google Fonts — we load it from a CDN */
@font-face {
  font-family: 'OpenDyslexic';
  src: url('https://cdn.jsdelivr.net/npm/open-dyslexic@1.0.3/fonts/OpenDyslexic-Regular.otf') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'OpenDyslexic';
  src: url('https://cdn.jsdelivr.net/npm/open-dyslexic@1.0.3/fonts/OpenDyslexic-Bold.otf') format('opentype');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

/* ==========================================================================
   CSS Custom Properties — Design Tokens
   These are the single source of truth for every visual decision.
   Theme classes on <body> swap only the colour tokens; everything else stays.
   ========================================================================== */
:root {
  /* --- Colour palette: Cream (default, warm + calming) --- */
  --color-bg:           #FDF6E3;   /* warm cream page background */
  --color-bg-alt:       #F5EDD6;   /* slightly deeper cream for sections */
  --color-surface:      #FFFDF7;   /* card/panel surfaces */
  --color-surface-alt:  #FCEFD3;   /* hovered/selected surfaces */
  --color-border:       #E8DDD0;   /* subtle dividers */
  --color-border-focus: #C8762B;   /* accessible focus ring */

  /* Brand */
  --color-primary:      #C8621A;   /* warm saffron-orange — CTAs, links */
  --color-primary-hover:#A34E12;
  --color-primary-light:#FDE9D4;   /* tinted backgrounds */
  --color-secondary:    #2E7D6F;   /* forest teal — accents, badges */
  --color-secondary-light: #D1EDE9;

  /* Text */
  --color-text:         #2C1A10;   /* rich dark-brown body text */
  --color-text-muted:   #6B5040;   /* secondary/helper text */
  --color-text-on-primary: #FFFFFF;
  --color-text-link:    #C8621A;

  /* Feedback */
  --color-success:      #2E7D4F;
  --color-success-light:#D4EDE0;
  --color-warning:      #B45309;
  --color-warning-light:#FEF3C7;
  --color-error:        #C0392B;
  --color-error-light:  #FDECEA;

  /* --- Typography --- */
  --font-base:          'Lexend', 'Segoe UI', system-ui, sans-serif;
  --font-dyslexic:      'OpenDyslexic', 'Lexend', sans-serif;
  /* JS will set --font-active based on user preference */
  --font-active:        var(--font-base);

  --text-xs:   0.75rem;   /*  12px */
  --text-sm:   0.875rem;  /*  14px */
  --text-md:   1rem;      /*  16px */
  --text-lg:   1.125rem;  /*  18px */
  --text-xl:   1.25rem;   /*  20px */
  --text-2xl:  1.5rem;    /*  24px */
  --text-3xl:  1.875rem;  /*  30px */
  --text-4xl:  2.25rem;   /*  36px */
  --text-5xl:  3rem;      /*  48px */

  /* Reading-mode overrides (JS updates these from sliders) */
  --reading-font-size:      1.125rem;
  --reading-line-height:    1.85;
  --reading-letter-spacing: 0.04em;
  --reading-word-spacing:   0.12em;

  /* --- Spacing scale (8-point grid) --- */
  --sp-1:  0.25rem;   /*  4px */
  --sp-2:  0.5rem;    /*  8px */
  --sp-3:  0.75rem;   /* 12px */
  --sp-4:  1rem;      /* 16px */
  --sp-5:  1.25rem;   /* 20px */
  --sp-6:  1.5rem;    /* 24px */
  --sp-8:  2rem;      /* 32px */
  --sp-10: 2.5rem;    /* 40px */
  --sp-12: 3rem;      /* 48px */
  --sp-16: 4rem;      /* 64px */
  --sp-20: 5rem;      /* 80px */

  /* --- Layout --- */
  --max-width-text:    68ch;    /* comfortable reading column */
  --max-width-content: 72rem;   /* 1152px site container */
  --border-radius-sm:  0.375rem;
  --border-radius-md:  0.75rem;
  --border-radius-lg:  1.25rem;
  --border-radius-xl:  2rem;
  --border-radius-full: 9999px;

  /* --- Shadows --- */
  --shadow-sm:  0 1px 3px rgba(44,26,16,0.08);
  --shadow-md:  0 4px 12px rgba(44,26,16,0.1);
  --shadow-lg:  0 8px 24px rgba(44,26,16,0.12);
  --shadow-focus: 0 0 0 3px var(--color-border-focus);

  /* --- Transitions --- */
  --transition-fast:   150ms ease;
  --transition-base:   250ms ease;
  --transition-slow:   400ms ease;
}

/* --------------------------------------------------------------------------
   Theme: High Contrast
   <body class="theme-high-contrast">
   -------------------------------------------------------------------------- */
.theme-high-contrast {
  --color-bg:           #000000;
  --color-bg-alt:       #111111;
  --color-surface:      #1A1A1A;
  --color-surface-alt:  #222222;
  --color-border:       #555555;
  --color-border-focus: #FFD700;
  --color-primary:      #FFD700;
  --color-primary-hover:#FFC200;
  --color-primary-light:#2A2200;
  --color-secondary:    #00FFCC;
  --color-secondary-light: #003322;
  --color-text:         #FFFFFF;
  --color-text-muted:   #CCCCCC;
  --color-text-on-primary: #000000;
  --color-text-link:    #FFD700;
  --shadow-sm:  0 1px 3px rgba(0,0,0,0.6);
  --shadow-md:  0 4px 12px rgba(0,0,0,0.7);
  --shadow-lg:  0 8px 24px rgba(0,0,0,0.8);
}

/* --------------------------------------------------------------------------
   Theme: Dark Mode
   <body class="theme-dark">
   -------------------------------------------------------------------------- */
.theme-dark {
  --color-bg:           #1C1612;
  --color-bg-alt:       #251E17;
  --color-surface:      #2C2318;
  --color-surface-alt:  #362B1F;
  --color-border:       #4A3828;
  --color-border-focus: #E8872A;
  --color-primary:      #E8872A;
  --color-primary-hover:#D4721A;
  --color-primary-light:#3A2510;
  --color-secondary:    #4ECDB8;
  --color-secondary-light: #132E2A;
  --color-text:         #F5EDD6;
  --color-text-muted:   #A89080;
  --color-text-on-primary: #1C1612;
  --color-text-link:    #E8872A;
  --shadow-sm:  0 1px 3px rgba(0,0,0,0.4);
  --shadow-md:  0 4px 12px rgba(0,0,0,0.5);
  --shadow-lg:  0 8px 24px rgba(0,0,0,0.6);
}

/* --------------------------------------------------------------------------
   Font preference: .font-dyslexic on <body> switches the active font
   -------------------------------------------------------------------------- */
.font-dyslexic {
  --font-active: var(--font-dyslexic);
}

/* ==========================================================================
   Base Reset + Box Model
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;               /* base for rem calculations */
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-active);
  font-size: var(--text-md);
  line-height: 1.7;
  color: var(--color-text);
  background-color: var(--color-bg);
  transition:
    background-color var(--transition-slow),
    color var(--transition-slow);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Ensure main content area grows to push footer down */
main {
  flex: 1;
}

img, svg {
  display: block;
  max-width: 100%;
}

/* Remove list styling when lists are used for UI, not content */
ul[role="list"], ol[role="list"] {
  list-style: none;
}

/* ==========================================================================
   Typography
   ========================================================================== */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-active);
  line-height: 1.25;
  color: var(--color-text);
  font-weight: 600;
}

h1 { font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl)); }
h2 { font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl)); }
h3 { font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl)); }
h4 { font-size: var(--text-xl); }
h5 { font-size: var(--text-lg); }
h6 { font-size: var(--text-md); }

p {
  max-width: var(--max-width-text);
  color: var(--color-text);
}

a {
  color: var(--color-text-link);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
  transition: color var(--transition-fast);
}

a:hover {
  color: var(--color-primary-hover);
}

strong, b {
  font-weight: 600;
}

/* ==========================================================================
   Focus Styles — Visible for keyboard users
   ========================================================================== */
:focus-visible {
  outline: 3px solid var(--color-border-focus);
  outline-offset: 3px;
  border-radius: var(--border-radius-sm);
}

/* Remove default focus ring for mouse users (browsers handle this via :focus-visible) */
:focus:not(:focus-visible) {
  outline: none;
}

/* ==========================================================================
   Layout Utilities
   ========================================================================== */
.container {
  width: 100%;
  max-width: var(--max-width-content);
  margin-inline: auto;
  padding-inline: var(--sp-6);
}

@media (max-width: 640px) {
  .container {
    padding-inline: var(--sp-4);
  }
}

.section {
  padding-block: var(--sp-16);
}

.section--alt {
  background-color: var(--color-bg-alt);
}

/* Flexbox helpers */
.flex        { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between{ display: flex; align-items: center; justify-content: space-between; }
.flex-col    { display: flex; flex-direction: column; }
.gap-2  { gap: var(--sp-2); }
.gap-4  { gap: var(--sp-4); }
.gap-6  { gap: var(--sp-6); }
.gap-8  { gap: var(--sp-8); }

/* Grid helpers */
.grid { display: grid; }

/* Text alignment */
.text-center { text-align: center; }
.text-left   { text-align: left; }

/* Visually hidden (accessible) */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ==========================================================================
   Shared Components
   ========================================================================== */

/* --- Buttons --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-6);
  font-family: var(--font-active);
  font-size: var(--text-md);
  font-weight: 500;
  line-height: 1.2;
  border: 2px solid transparent;
  border-radius: var(--border-radius-full);
  cursor: pointer;
  text-decoration: none;
  transition:
    background-color var(--transition-fast),
    color var(--transition-fast),
    border-color var(--transition-fast),
    transform var(--transition-fast),
    box-shadow var(--transition-fast);
  white-space: nowrap;
  user-select: none;
}

.btn:active {
  transform: scale(0.97);
}

.btn--primary {
  background-color: var(--color-primary);
  color: var(--color-text-on-primary);
  border-color: var(--color-primary);
}

.btn--primary:hover {
  background-color: var(--color-primary-hover);
  border-color: var(--color-primary-hover);
  color: var(--color-text-on-primary);
  box-shadow: var(--shadow-md);
}

.btn--secondary {
  background-color: transparent;
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.btn--secondary:hover {
  background-color: var(--color-primary-light);
  color: var(--color-primary-hover);
}

.btn--ghost {
  background-color: transparent;
  color: var(--color-text-muted);
  border-color: var(--color-border);
}

.btn--ghost:hover {
  background-color: var(--color-surface-alt);
  color: var(--color-text);
}

.btn--large {
  font-size: var(--text-lg);
  padding: var(--sp-4) var(--sp-8);
}

.btn--small {
  font-size: var(--text-sm);
  padding: var(--sp-2) var(--sp-4);
}

.btn--icon {
  padding: var(--sp-2);
  border-radius: var(--border-radius-md);
}

/* --- Cards --- */
.card {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--sp-6);
  box-shadow: var(--shadow-sm);
  transition:
    box-shadow var(--transition-base),
    transform var(--transition-base),
    border-color var(--transition-base);
}

.card--interactive:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-2px);
  border-color: var(--color-border-focus);
}

.card--interactive:focus-within {
  box-shadow: var(--shadow-focus), var(--shadow-md);
}

/* --- Badges / Tags --- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: var(--border-radius-full);
  background-color: var(--color-secondary-light);
  color: var(--color-secondary);
}

.badge--primary {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

/* --- Form elements --- */
.label {
  display: block;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: var(--sp-2);
}

.input {
  width: 100%;
  padding: var(--sp-3) var(--sp-4);
  font-family: var(--font-active);
  font-size: var(--text-md);
  color: var(--color-text);
  background-color: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--border-radius-md);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.input:focus-visible {
  border-color: var(--color-primary);
  outline: none;
  box-shadow: 0 0 0 3px var(--color-primary-light);
}

.input::placeholder {
  color: var(--color-text-muted);
  opacity: 0.7;
}

/* Range sliders */
.slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 6px;
  border-radius: var(--border-radius-full);
  background: var(--color-border);
  outline: none;
  cursor: pointer;
}

.slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--color-primary);
  border: 3px solid var(--color-surface);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: transform var(--transition-fast);
}

.slider::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

/* Toggle (checkbox as switch) */
.toggle {
  position: relative;
  display: inline-block;
  width: 48px;
  height: 26px;
}

.toggle input {
  opacity: 0;
  width: 0;
  height: 0;
}

.toggle__track {
  position: absolute;
  inset: 0;
  background-color: var(--color-border);
  border-radius: var(--border-radius-full);
  transition: background-color var(--transition-base);
  cursor: pointer;
}

.toggle__track::before {
  content: '';
  position: absolute;
  height: 18px;
  width: 18px;
  left: 4px;
  top: 4px;
  background-color: var(--color-surface);
  border-radius: 50%;
  transition: transform var(--transition-base);
}

.toggle input:checked + .toggle__track {
  background-color: var(--color-primary);
}

.toggle input:checked + .toggle__track::before {
  transform: translateX(22px);
}

.toggle input:focus-visible + .toggle__track {
  box-shadow: var(--shadow-focus);
}

/* ==========================================================================
   Navigation Bar
   ========================================================================== */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  height: 64px;
}

.nav__logo {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  text-decoration: none;
  font-weight: 700;
  font-size: var(--text-xl);
  color: var(--color-text);
  flex-shrink: 0;
}

.nav__logo-icon {
  font-size: 1.5rem;
  line-height: 1;
}

.nav__logo span {
  color: var(--color-primary);
}

.nav__links {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  list-style: none;
}

.nav__link {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--border-radius-md);
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.nav__link:hover,
.nav__link[aria-current="page"] {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.nav__link[aria-current="page"] {
  font-weight: 600;
}

/* Hamburger for mobile */
.nav__toggle {
  display: none;
  background: none;
  border: none;
  padding: var(--sp-2);
  cursor: pointer;
  color: var(--color-text);
  border-radius: var(--border-radius-md);
}

@media (max-width: 700px) {
  .nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav__links {
    display: none;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--sp-2) var(--sp-4);
    box-shadow: var(--shadow-md);
  }

  .nav__links.is-open {
    display: flex;
  }

  .nav__link {
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--text-md);
  }
}

/* ==========================================================================
   Skip Navigation Link (keyboard accessibility)
   ========================================================================== */
.skip-nav {
  position: absolute;
  top: -100px;
  left: var(--sp-4);
  padding: var(--sp-3) var(--sp-6);
  background-color: var(--color-primary);
  color: var(--color-text-on-primary);
  font-weight: 600;
  border-radius: var(--border-radius-md);
  text-decoration: none;
  z-index: 999;
  transition: top var(--transition-fast);
}

.skip-nav:focus {
  top: var(--sp-4);
}

/* ==========================================================================
   Footer
   ========================================================================== */
.footer {
  background-color: var(--color-bg-alt);
  border-top: 1px solid var(--color-border);
  padding-block: var(--sp-10);
  margin-top: auto;
}

.footer__inner {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  justify-content: space-between;
  align-items: flex-start;
}

.footer__brand {
  max-width: 28ch;
}

.footer__brand-name {
  font-size: var(--text-xl);
  font-weight: 700;
  margin-bottom: var(--sp-2);
}

.footer__brand-name span {
  color: var(--color-primary);
}

.footer__tagline {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
  max-width: 100%;
}

.footer__links-group {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.footer__links-heading {
  font-size: var(--text-sm);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: var(--sp-1);
}

.footer__link {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer__link:hover {
  color: var(--color-primary);
}

.footer__bottom {
  margin-top: var(--sp-8);
  padding-top: var(--sp-6);
  border-top: 1px solid var(--color-border);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-4);
  justify-content: space-between;
  align-items: center;
}

/* ==========================================================================
   Progress Bar (used in lesson pages)
   ========================================================================== */
.progress-bar {
  height: 8px;
  background-color: var(--color-border);
  border-radius: var(--border-radius-full);
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  background-color: var(--color-primary);
  border-radius: var(--border-radius-full);
  transition: width var(--transition-slow);
}

/* ==========================================================================
   Pill / Mode Indicator
   ========================================================================== */
.mode-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-1) var(--sp-4);
  border-radius: var(--border-radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.mode-pill--read {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.mode-pill--learn {
  background-color: var(--color-secondary-light);
  color: var(--color-secondary);
}

/* ==========================================================================
   Responsive Typography Helpers
   ========================================================================== */
.heading-display {
  font-size: clamp(2.25rem, 6vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.heading-section {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-weight: 600;
  line-height: 1.2;
}

.body-large {
  font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
  line-height: 1.7;
}

/* ==========================================================================
   Decorative / Accent elements
   ========================================================================== */
.accent-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-primary);
  vertical-align: middle;
}

/* Highlight text */
.highlight {
  color: var(--color-primary);
}

.highlight--teal {
  color: var(--color-secondary);
}
