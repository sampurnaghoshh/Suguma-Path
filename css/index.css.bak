/* ==========================================================================
   SugamaPath — Landing Page Styles (index.html)
   Imports global.css first, then adds page-specific styles.
   ========================================================================== */

/* ==========================================================================
   Hero Section
   ========================================================================== */
.hero {
  position: relative;
  overflow: hidden;
  padding-block: var(--sp-20) var(--sp-16);
  background-color: var(--color-bg);
}

/* Warm, subtle radial gradient behind the hero content */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 60% 30%, rgba(200, 98, 26, 0.08) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 20% 80%, rgba(46, 125, 111, 0.06) 0%, transparent 60%);
  pointer-events: none;
}

.hero__inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-12);
  align-items: center;
}

@media (max-width: 900px) {
  .hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero__actions {
    justify-content: center;
  }

  .hero__visual {
    order: -1;
  }
}

.hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-5);
  padding: var(--sp-1) var(--sp-3);
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--border-radius-full);
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.hero__title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-bottom: var(--sp-6);
}

.hero__title-accent {
  color: var(--color-primary);
  display: block;
}

.hero__subtitle {
  font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
  line-height: 1.75;
  color: var(--color-text-muted);
  margin-bottom: var(--sp-8);
  max-width: 52ch;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-4);
  align-items: center;
}

.hero__note {
  margin-top: var(--sp-5);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.hero__note svg {
  display: inline;
  flex-shrink: 0;
}

/* --- Hero Visual --- */
.hero__visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-card {
  position: relative;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-xl);
  padding: var(--sp-6);
  box-shadow: var(--shadow-lg);
  max-width: 380px;
  width: 100%;
}

.hero-card__header {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-bottom: var(--sp-5);
  padding-bottom: var(--sp-4);
  border-bottom: 1px solid var(--color-border);
}

.hero-card__dots {
  display: flex;
  gap: var(--sp-1);
}

.hero-card__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.hero-card__dot:nth-child(1) { background-color: #FF6058; }
.hero-card__dot:nth-child(2) { background-color: #FFBD2E; }
.hero-card__dot:nth-child(3) { background-color: #28CA41; }

.hero-card__title {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--color-text-muted);
}

/* Simulated text lines */
.hero-card__lines {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-bottom: var(--sp-5);
}

.hero-card__line {
  height: 10px;
  border-radius: var(--border-radius-full);
  background-color: var(--color-bg-alt);
  transition: background-color var(--transition-slow);
}

.hero-card__line--short  { width: 55%; }
.hero-card__line--medium { width: 80%; }
.hero-card__line--long   { width: 100%; }
.hero-card__line--highlight {
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary-light) 80%, transparent);
  border-left: 3px solid var(--color-primary);
  padding-left: var(--sp-2);
}

/* Kannada script preview */
.hero-card__script {
  background-color: var(--color-bg-alt);
  border-radius: var(--border-radius-md);
  padding: var(--sp-4);
  text-align: center;
}

.hero-card__script-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--sp-3);
}

.hero-card__script-chars {
  display: flex;
  justify-content: center;
  gap: var(--sp-4);
  flex-wrap: wrap;
}

.hero-card__script-char {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-1);
}

.hero-card__script-glyph {
  font-size: 2rem;
  line-height: 1;
  color: var(--color-primary);
  font-weight: 400;
}

.hero-card__script-roman {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

/* Floating badges on the card */
.hero-card__badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-full);
  box-shadow: var(--shadow-md);
  font-size: var(--text-xs);
  font-weight: 600;
  white-space: nowrap;
  color: var(--color-text);
}

.hero-card__badge--tts {
  top: -16px;
  right: -16px;
  color: var(--color-secondary);
}

.hero-card__badge--streak {
  bottom: -16px;
  left: -16px;
  color: var(--color-warning);
}

/* ==========================================================================
   Modes Section — "Two tools, one platform"
   ========================================================================== */
.modes {
  padding-block: var(--sp-16);
}

.modes__header {
  text-align: center;
  margin-bottom: var(--sp-12);
}

.modes__header p {
  margin-inline: auto;
  color: var(--color-text-muted);
  font-size: var(--text-lg);
  margin-top: var(--sp-4);
}

.modes__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-8);
}

@media (max-width: 800px) {
  .modes__grid {
    grid-template-columns: 1fr;
  }
}

.mode-card {
  background-color: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--border-radius-xl);
  padding: var(--sp-8);
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
  transition:
    border-color var(--transition-base),
    box-shadow var(--transition-base),
    transform var(--transition-base);
  text-decoration: none;
  color: var(--color-text);
}

.mode-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
  text-decoration: none;
  color: var(--color-text);
}

.mode-card--read:hover  { border-color: var(--color-primary); }
.mode-card--learn:hover { border-color: var(--color-secondary); }

.mode-card__icon {
  width: 56px;
  height: 56px;
  border-radius: var(--border-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  line-height: 1;
  flex-shrink: 0;
}

.mode-card--read  .mode-card__icon { background-color: var(--color-primary-light); }
.mode-card--learn .mode-card__icon { background-color: var(--color-secondary-light); }

.mode-card__tag {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mode-card--read  .mode-card__tag { color: var(--color-primary); }
.mode-card--learn .mode-card__tag { color: var(--color-secondary); }

.mode-card__title {
  font-size: var(--text-2xl);
  font-weight: 700;
  line-height: 1.2;
  margin: 0;
}

.mode-card__desc {
  font-size: var(--text-md);
  color: var(--color-text-muted);
  line-height: 1.7;
  max-width: 100%;
}

.mode-card__features {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  list-style: none;
}

.mode-card__feature {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.mode-card__feature::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.mode-card--read  .mode-card__feature::before { background-color: var(--color-primary); }
.mode-card--learn .mode-card__feature::before { background-color: var(--color-secondary); }

.mode-card__cta {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: var(--text-sm);
  font-weight: 600;
  margin-top: auto;
  padding-top: var(--sp-2);
  transition: gap var(--transition-fast);
}

.mode-card--read  .mode-card__cta { color: var(--color-primary); }
.mode-card--learn .mode-card__cta { color: var(--color-secondary); }

.mode-card:hover .mode-card__cta {
  gap: var(--sp-3);
}

/* ==========================================================================
   Accessibility Features Section
   ========================================================================== */
.features {
  padding-block: var(--sp-16);
}

.features__header {
  text-align: center;
  margin-bottom: var(--sp-12);
}

.features__header p {
  margin-inline: auto;
  color: var(--color-text-muted);
  margin-top: var(--sp-4);
  font-size: var(--text-lg);
}

.features__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--sp-6);
}

.feature-item {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--sp-6);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.feature-item__icon {
  font-size: 2rem;
  line-height: 1;
  width: 52px;
  height: 52px;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-alt);
}

.feature-item__title {
  font-size: var(--text-lg);
  font-weight: 600;
  margin: 0;
}

.feature-item__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.65;
  max-width: 100%;
}

/* ==========================================================================
   Mission / Philosophy section
   ========================================================================== */
.mission {
  padding-block: var(--sp-16);
  background-color: var(--color-bg-alt);
}

.mission__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-16);
  align-items: center;
}

@media (max-width: 800px) {
  .mission__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .mission__quote {
    margin-inline: auto;
  }
}

.mission__eyebrow {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-secondary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--sp-4);
}

.mission__heading {
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: var(--sp-5);
}

.mission__body {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  line-height: 1.8;
  max-width: 100%;
  margin-bottom: var(--sp-6);
}

.mission__languages {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.mission__lang-tag {
  padding: var(--sp-2) var(--sp-4);
  border-radius: var(--border-radius-full);
  font-size: var(--text-sm);
  font-weight: 500;
  border: 1px solid var(--color-border);
  background-color: var(--color-surface);
  color: var(--color-text-muted);
}

.mission__lang-tag--active {
  background-color: var(--color-secondary-light);
  color: var(--color-secondary);
  border-color: var(--color-secondary);
  font-weight: 600;
}

.mission__quote {
  position: relative;
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-xl);
  padding: var(--sp-8);
  box-shadow: var(--shadow-md);
  max-width: 480px;
}

.mission__quote-mark {
  font-size: 5rem;
  line-height: 0.8;
  color: var(--color-primary);
  opacity: 0.25;
  font-family: Georgia, serif;
  position: absolute;
  top: var(--sp-4);
  left: var(--sp-6);
}

.mission__quote-text {
  font-size: var(--text-xl);
  font-style: italic;
  line-height: 1.65;
  color: var(--color-text);
  margin-bottom: var(--sp-4);
  padding-top: var(--sp-4);
  max-width: 100%;
}

.mission__quote-attr {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  font-weight: 500;
}

/* ==========================================================================
   CTA Banner
   ========================================================================== */
.cta-banner {
  padding-block: var(--sp-16);
  text-align: center;
}

.cta-banner__inner {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-secondary-light) 100%);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-xl);
  padding: var(--sp-12) var(--sp-8);
}

.cta-banner__title {
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  font-weight: 700;
  margin-bottom: var(--sp-4);
}

.cta-banner__subtitle {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  margin-bottom: var(--sp-8);
  margin-inline: auto;
  max-width: 52ch;
}

.cta-banner__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-4);
  justify-content: center;
}
